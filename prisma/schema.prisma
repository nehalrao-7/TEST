// Game6 Sports Academy — data model.
// Postgres (Neon / Vercel Postgres) in every environment via DATABASE_URL.
// Status fields are plain strings validated in app code (kept portable).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The active season drives the site banner + registration status. Making this
/// data-driven structurally fixes the "hardcoded Spring banner" pain point:
/// once the admin UI lands, Game6 flips these fields with no developer.
model Season {
  id                 String   @id @default(cuid())
  label              String // e.g. "Spring", "Summer", "Fall", "Winter"
  year               Int
  // OPEN | CLOSED | WAITLIST  (validated in app code; SQLite has no enums)
  registrationStatus String   @default("OPEN")
  headline           String? // optional banner override copy
  isActive           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Youth programs / "the league". Editable per season once admin lands.
model Program {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  blurb         String // short card line
  details       String // longer description
  weeklyCadence String? // e.g. "1x or 2x weekly", "Sat game + 1 weeknight"
  ageHint       String? // soft guidance only — never a hard, fixed bracket
  imagePath     String? // /images/...  (B&W placeholder, swappable)
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  classes       ClassSession[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Front-facing offer (e.g. "Free League Drop-In, ages 14–16"). This is a
/// presentation layer over a class already running — `mappedClassNote` records
/// which real class it maps onto. Schema only this pass; the calendar mapping
/// + admin UI arrive in a later pass.
model Offer {
  id            String   @id @default(cuid())
  label         String
  ageRangeLabel String? // soft, marketing-facing range
  mappedClassNote String? // internal free-text fallback for the mapped class
  // The facade mechanic: an offer is a presentation layer over a class that is
  // already running. Linking to a real ClassSession means "free drop-in" just
  // shows up as new kids on an existing class — no separate event scheduled.
  classSessionId String?
  classSession   ClassSession? @relation(fields: [classSessionId], references: [id], onDelete: SetNull)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// The base inventory layer — physical courts. Programs reserve court time via
/// ClassSessions; rentals fill whatever is left via Bookings. This layer is
/// internal/owner-only; it is never exposed as a public availability calendar.
model Court {
  id        String   @id @default(cuid())
  name      String // e.g. "Court 1", "Main Court"
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  classes   ClassSession[]
  bookings  Booking[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A recurring class on the real calendar (e.g. "HS Practice, Tuesdays 6–8pm").
/// This is what actually consumes court time. Offers map onto these so a public
/// "free drop-in" resolves to a class already on the books.
model ClassSession {
  id        String   @id @default(cuid())
  name      String
  weekday   Int // 0=Sunday .. 6=Saturday
  startTime String // "18:00" (24h, local)
  endTime   String // "20:00"
  capacity  Int?
  ageHint   String? // soft guidance only — never a hard bracket
  notes     String?
  isActive  Boolean  @default(true)

  programId String?
  program   Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  courtId   String?
  court     Court?   @relation(fields: [courtId], references: [id], onDelete: SetNull)

  offers    Offer[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Owner-controlled, one-off court reservations: rentals, program holds, events.
/// Logged by Game6 internally — there is no public booking surface, by design.
model Booking {
  id        String   @id @default(cuid())
  title     String // e.g. "Rental — Smith group"
  type      String   @default("RENTAL") // RENTAL | PROGRAM | HOLD
  date      DateTime // the day of the booking
  startTime String // "20:00"
  endTime   String // "22:00"
  contact   String?
  notes     String?
  courtId   String?
  court     Court?   @relation(fields: [courtId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A captured free-class lead. Written AND emailed to Game6 on submit.
model Lead {
  id           String   @id @default(cuid())
  kidName      String
  parentName   String
  parentPhone  String
  birthYear    Int?
  experience   String? // free text: none / rec / competitive, etc.
  offerLabel   String? // which offer the parent thinks they signed up for
  source       String   @default("website")
  createdAt    DateTime @default(now())
}
