# ---- Database (Postgres) ----
# Prisma reads POSTGRES_PRISMA_URL (pooled, runtime) and POSTGRES_URL_NON_POOLING
# (direct, for migrations / db push). On Vercel, the Neon integration sets both
# automatically. Locally, point both at your Postgres (the same URL is fine).
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST:5432/db?schema=public"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:5432/db?schema=public"

# ---- Lead notification email (Resend) ----
# Without these, lead submissions still save to the DB and the payload is logged
# to the server console — so the funnel is testable with no key.
RESEND_API_KEY=""
# Where new leads are emailed (Game6's inbox):
LEAD_NOTIFY_EMAIL=""
# Verified sender. Until you verify a domain in Resend, the shared
# "onboarding@resend.dev" sender works for testing.
RESEND_FROM="Game6 Leads <onboarding@resend.dev>"

# ---- Admin panel (/admin) ----
# Shared password Game6 uses to sign in to the admin.
ADMIN_PASSWORD="change-me"
# Secret used to sign the admin session cookie. Use a long random string in prod
# (e.g. `openssl rand -hex 32`).
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

