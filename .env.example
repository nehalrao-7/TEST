# ---- Database ----
# Local dev (SQLite). For production, switch prisma/schema.prisma `provider`
# to "postgresql" and set a Postgres connection string here (Neon / Vercel Postgres).
DATABASE_URL="file:./dev.db"

# ---- Lead notification email (Resend) ----
# Without these, lead submissions still save to the DB and the payload is logged
# to the server console — so the funnel is testable with no key.
RESEND_API_KEY=""
# Where new leads are emailed (Game6's inbox):
LEAD_NOTIFY_EMAIL=""
# Verified sender. Until you verify a domain in Resend, the shared
# "onboarding@resend.dev" sender works for testing.
RESEND_FROM="Game6 Leads <onboarding@resend.dev>"
